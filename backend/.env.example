# Server Configuration
PORT=4000
NODE_ENV=development

# Security
JWT_SECRET=traceops_dev_secret_change_in_production_key_12345
JWT_EXPIRES_IN=7d

# PostgreSQL Database (matches docker-compose.yml)
DATABASE_URL="postgresql://traceops_user:traceops_password@localhost:5432/traceops_db?schema=public"

# Redis Cache & Rate Limiter (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Gateway Configuration
GATEWAY_DEFAULT_TIMEOUT_MS=5000
GATEWAY_MAX_BODY_SIZE="10mb"
